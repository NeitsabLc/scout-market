{% extends 'base.html.twig' %}
{% block title %}Utilisateurs | Scout Market{% endblock %}
{% block body %}<main class="users-page entity-list-page"><header class="foods-heading entity-list-heading"><div><h1>Utilisateurs</h1></div><a class="food-primary food-add-button" href="{{ path('app_utilisateur_ajouter') }}"><span aria-hidden="true">＋</span><span>Ajouter un utilisateur</span></a></header>{% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}<section class="foods-card"><div class="foods-table"><div class="foods-row foods-row--head"><span>Utilisateur</span><span>Rôle</span><span>Unité</span><span>Statut</span><span>Actions</span></div>{% for utilisateur in utilisateurs %}<div class="foods-row"><a class="food-name" href="{{ path('app_utilisateur_modifier', {id: utilisateur.id}) }}"><strong>{{ utilisateur.prenom }} {{ utilisateur.nom }}</strong><small>{{ utilisateur.email }}</small></a><span>{{ roles[utilisateur.role]|default(utilisateur.role) }}</span><span>{{ utilisateur.groupe ? utilisateur.groupe.nom : '—' }}</span><span>{{ utilisateur.actif ? 'Actif' : 'Inactif' }}</span><span class="food-actions"><a class="action-icon-button" href="{{ path('app_utilisateur_modifier', {id: utilisateur.id}) }}" aria-label="Modifier {{ utilisateur.prenom }} {{ utilisateur.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a><form method="post" action="{{ path('app_utilisateurs_statut', {id: utilisateur.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut_utilisateur_' ~ utilisateur.id) }}"><button class="action-icon-button{{ utilisateur.actif ? ' action-icon-button--danger' : '' }}" type="submit" aria-label="{{ utilisateur.actif ? 'Désactiver' : 'Réactiver' }} {{ utilisateur.prenom }} {{ utilisateur.nom }}" title="{{ utilisateur.actif ? 'Désactiver' : 'Réactiver' }}">{% if utilisateur.actif %}<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{% else %}<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}<span class="visually-hidden">{{ utilisateur.actif ? 'Désactiver' : 'Réactiver' }}</span></button></form></span></div>{% else %}<div class="foods-empty">Aucun utilisateur</div>{% endfor %}</div></section></main>{% endblock %}
