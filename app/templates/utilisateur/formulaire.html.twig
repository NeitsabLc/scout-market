{% extends 'base.html.twig' %}
{% block title %}{{ donnees.utilisateur_id ? donnees.prenom ~ ' ' ~ donnees.nom : 'Ajouter un utilisateur' }} | Scout Market{% endblock %}
{% block body %}<main class="food-form-page"><nav class="food-breadcrumb"><a href="{{ path('app_utilisateurs') }}">Utilisateurs</a><span>/</span><span>{{ donnees.utilisateur_id ? 'Modifier' : 'Ajouter' }}</span></nav><header class="food-form-heading"><h1>{{ donnees.utilisateur_id ? donnees.prenom ~ ' ' ~ donnees.nom : 'Ajouter un utilisateur' }}</h1>{% if donnees.utilisateur_id %}<form method="post" action="{{ path('app_utilisateur_invitation', {id: donnees.utilisateur_id}) }}" onsubmit="return confirm('Le mot de passe actuel et l’ancien lien d’invitation ne fonctionneront plus. Continuer ?')"><input type="hidden" name="_token" value="{{ csrf_token('invitation_utilisateur_' ~ donnees.utilisateur_id) }}"><button class="food-secondary" type="submit">Renvoyer le mail d’invitation</button></form>{% endif %}</header>
{% if erreurs %}<div class="flash flash--error" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('creer_utilisateur') }}"><input type="hidden" name="utilisateur_id" value="{{ donnees.utilisateur_id }}"><section class="food-form-card"><div class="group-form-grid"><label class="user-field">Prénom<input name="prenom" required maxlength="100" value="{{ donnees.prenom }}"></label><label class="user-field">Nom<input name="nom" required maxlength="100" value="{{ donnees.nom }}"></label><label class="user-field">E-mail<input type="email" name="email" required maxlength="180" value="{{ donnees.email }}"></label><label class="user-field">Rôle<select name="role" required>{% for code, libelle in roles %}<option value="{{ code }}"{{ donnees.role == code ? ' selected' : '' }}>{{ libelle }}</option>{% endfor %}</select></label><label class="user-field">Unité participante <small>Obligatoire uniquement pour le rôle « Unité participante ».</small><select name="groupe"><option value="">Aucune</option>{% for groupe in groupes %}<option value="{{ groupe.id }}"{{ donnees.groupe == groupe.id ~ '' ? ' selected' : '' }}>{{ groupe.nom }}</option>{% endfor %}</select></label></div></section><div class="food-form-actions"><a class="food-secondary" href="{{ path('app_utilisateurs') }}">Annuler</a><button class="food-primary">Enregistrer</button></div></form></main>{% endblock %}
