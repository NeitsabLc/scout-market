<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Scout Market{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endblock %}
    {% block javascripts %}{% block importmap %}{{ importmap('app', {nonce: app.request.attributes.get('csp_nonce')}) }}{% endblock %}{% endblock %}
</head>
<body class="{% block body_class %}{{ app.user ? 'app-shell' : 'auth-shell' }}{% endblock %}">
<a class="skip-link" href="#contenu-principal">Aller au contenu</a>
{% set afficher_navigation = app.user and app.current_route != 'app_sortie_consommation' %}
{% if afficher_navigation %}
<button class="mobile-nav-toggle" type="button" data-sidebar-toggle aria-label="Ouvrir le menu">☰</button>
<aside class="sidebar{{ is_granted('ROLE_ADMIN') ? ' sidebar--admin' : '' }}" data-sidebar>
    <div class="sidebar__brand"><div class="sidebar__brand-identity" aria-label="Scout Market"><span class="sidebar__brand-symbol" aria-hidden="true">SM</span><span><strong>Scout Market</strong></span></div><button type="button" data-sidebar-collapse aria-label="Replier le menu">‹</button></div>
    <nav class="sidebar__nav" aria-label="Navigation principale">
        <a class="sidebar__link" href="{{ path('app_tableau_de_bord') }}"{{ app.current_route == 'app_tableau_de_bord' ? ' aria-current="page"' : '' }}>
            <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4Z"/><path d="M9 20v-6h6v6"/></svg></span>
            <span class="sidebar__text">Accueil</span>
        </a>
        {% if is_granted('ROLE_GROUPE') %}
            <a class="sidebar__link" href="{{ path('app_menus') }}"{{ app.current_route starts with 'app_menu' ? ' aria-current="page"' : '' }}>
                <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 2v4M16 2v4M5 9h14"/></svg></span>
                <span class="sidebar__text">Menus</span>
            </a>
        {% endif %}
        {% if is_granted('ROLE_GESTIONNAIRE') %}
            {% set route_catalogue = app.current_route starts with 'app_fournisseur' or app.current_route starts with 'app_denree' %}
            {% set route_preparation = app.current_route starts with 'app_recette' or app.current_route starts with 'app_menu' or app.current_route starts with 'app_grille_menu' %}
            {% set route_flux = app.current_route starts with 'app_mouvement' or app.current_route starts with 'app_distribution' or app.current_route == 'app_commande' %}
            {% set route_gestion = app.current_route starts with 'app_groupe' or app.current_route starts with 'app_utilisateur' %}

            <details class="sidebar__section" data-sidebar-section{{ route_catalogue ? ' open' : '' }}>
                <summary{{ route_catalogue ? ' aria-current="page"' : '' }}>
                    <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></svg></span>
                    <span class="sidebar__text">Catalogue</span>
                    <span class="sidebar__chevron sidebar__text">›</span>
                </summary>
                <div class="sidebar-module-panel">
                    <header><span><small>Section</small><strong>Catalogue</strong></span><button type="button" data-sidebar-panel-close aria-label="Fermer le sous-menu">×</button></header>
                    <nav aria-label="Sous-menu Catalogue">
                        <a href="{{ path('app_fournisseurs') }}"{{ app.current_route starts with 'app_fournisseur' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></span><span><strong>Fournisseurs</strong><small>Contacts et références</small></span></a>
                        <a href="{{ path('app_denrees') }}"{{ app.current_route starts with 'app_denree' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/></svg></span><span><strong>Denrées</strong><small>Produits et conditionnements</small></span></a>
                    </nav>
                </div>
            </details>

            <details class="sidebar__section" data-sidebar-section{{ route_preparation ? ' open' : '' }}>
                <summary{{ route_preparation ? ' aria-current="page"' : '' }}>
                    <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg></span>
                    <span class="sidebar__text">Préparation</span>
                    <span class="sidebar__chevron sidebar__text">›</span>
                </summary>
                <div class="sidebar-module-panel">
                    <header><span><small>Section</small><strong>Préparation</strong></span><button type="button" data-sidebar-panel-close aria-label="Fermer le sous-menu">×</button></header>
                    <nav aria-label="Sous-menu Préparation">
                        <a href="{{ path('app_recettes') }}"{{ app.current_route starts with 'app_recette' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg></span><span><strong>Recettes</strong><small>Préparations enregistrées</small></span></a>
                        <a href="{{ path('app_menus') }}"{{ app.current_route starts with 'app_menu' or app.current_route starts with 'app_grille_menu' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 2v4M16 2v4M5 9h14"/></svg></span><span><strong>Menus</strong><small>Grilles et planification</small></span></a>
                    </nav>
                </div>
            </details>

            <details class="sidebar__section" data-sidebar-section{{ route_flux ? ' open' : '' }}>
                <summary{{ route_flux ? ' aria-current="page"' : '' }}>
                    <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 8h14M14 4l4 4-4 4M20 16H6M10 12l-4 4 4 4"/></svg></span>
                    <span class="sidebar__text">Flux</span>
                    <span class="sidebar__chevron sidebar__text">›</span>
                </summary>
                <div class="sidebar-module-panel">
                    <header><span><small>Section</small><strong>Flux</strong></span><button type="button" data-sidebar-panel-close aria-label="Fermer le sous-menu">×</button></header>
                    <nav aria-label="Sous-menu Flux">
                        <a href="{{ path('app_mouvements_stock') }}"{{ app.current_route starts with 'app_mouvement' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 8h14M14 4l4 4-4 4M20 16H6M10 12l-4 4 4 4"/></svg></span><span><strong>Mouvements de stock</strong><small>Entrées et sorties</small></span></a>
                        <a href="{{ path('app_distribution_scout_market') }}"{{ app.current_route starts with 'app_distribution' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h12M12 8l4 4-4 4M19 5v14"/></svg></span><span><strong>Distribution</strong><small>Scout Market et caisses</small></span></a>
                        <a href="{{ path('app_commande') }}"{{ app.current_route == 'app_commande' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h2l2 10h9l2-7H7M10 19h.01M17 19h.01"/></svg></span><span><strong>Commande</strong><small>Quantités à commander</small></span></a>
                    </nav>
                </div>
            </details>

            <details class="sidebar__section sidebar__section--management" data-sidebar-section{{ route_gestion ? ' open' : '' }}>
                <summary{{ route_gestion ? ' aria-current="page"' : '' }}>
                    <span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M18 13v6M15 16h6"/></svg></span>
                    <span class="sidebar__text">Gestion</span>
                    <span class="sidebar__chevron sidebar__text">›</span>
                </summary>
                <div class="sidebar-module-panel">
                    <header><span><small>Section</small><strong>Gestion</strong></span><button type="button" data-sidebar-panel-close aria-label="Fermer le sous-menu">×</button></header>
                    <nav aria-label="Sous-menu Gestion">
                        <a href="{{ path('app_groupes') }}"{{ app.current_route starts with 'app_groupe' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="10" r="2.5"/><path d="M2 20a6 6 0 0 1 12 0M13 20a5 5 0 0 1 9 0"/></svg></span><span><strong>Unités participantes</strong><small>Effectifs et besoins</small></span></a>
                        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_utilisateurs') }}"{{ app.current_route starts with 'app_utilisateur' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 11a3 3 0 0 1 0 6M19 20v-2"/></svg></span><span><strong>Utilisateurs</strong><small>Comptes et accès</small></span></a>{% endif %}
                    </nav>
                </div>
            </details>
        {% endif %}
    </nav>
    <nav class="sidebar__legal-mobile" aria-label="Informations légales"><span>Version {{ app_version }}</span><a href="{{ path('app_conditions_utilisation') }}">Conditions d’utilisation</a><a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a></nav>
    <div class="sidebar__account"><a class="sidebar__user user-summary" href="{{ path('app_mon_profil') }}"><span class="sidebar__avatar">{{ app.user.prenom|first }}{{ app.user.nom|first }}</span><span class="sidebar__text"><strong>{{ app.user.prenom }} {{ app.user.nom }}</strong><small>Mon profil</small></span></a><form class="sidebar__logout-form" method="post" action="{{ path('app_deconnexion') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="sidebar__logout" type="submit" aria-label="Se déconnecter" title="Se déconnecter"><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4M15 16l4-4-4-4M19 12H9"/></svg></span></button></form></div>
</aside><div class="sidebar-backdrop" data-sidebar-toggle></div>
{% endif %}
<div id="contenu-principal" tabindex="-1"{% if afficher_navigation %} class="page-content"{% endif %}>
    {% for message in app.flashes('success') %}<div class="flash flash--success global-flash" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash flash--error global-flash" role="alert">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error_auto_dismiss') %}<div class="flash flash--error global-flash" role="alert">{{ message }}</div>{% endfor %}
    {% block body %}{% endblock %}
</div>
<footer class="legal-footer{{ afficher_navigation ? ' legal-footer--with-sidebar' : '' }}"><span>Version {{ app_version }}</span><span aria-hidden="true">—</span><a href="{{ path('app_conditions_utilisation') }}">Conditions d’utilisation</a><span aria-hidden="true">—</span><a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a></footer>
</body>
</html>
