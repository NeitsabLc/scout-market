<nav class="group-menu-date-nav{{ mode_gestionnaire|default(false) ? ' manager-menu-date-nav' : '' }}" aria-label="Navigation entre les jours">
    {% set route_date = mode_gestionnaire|default(false) ? 'app_grille_menu_modifier' : 'app_menus' %}
    {% if jour_precedent %}<a class="group-menu-date-arrow" href="{{ path(route_date, mode_gestionnaire|default(false) ? {id: grille.id, date: jour_precedent|date('Y-m-d'), repas: repas_selectionne_id} : {date: jour_precedent|date('Y-m-d')}) }}" aria-label="Jour précédent">‹</a>{% else %}<span class="group-menu-date-arrow group-menu-date-arrow--disabled" aria-hidden="true">‹</span>{% endif %}
    {% if mode_gestionnaire|default(false) %}
        <form class="menu-date-picker" method="get" action="{{ path(route_date, {id: grille.id}) }}" data-controller="menu-date">
            <input type="hidden" name="repas" value="{{ repas_selectionne_id }}">
            <button class="menu-date-picker__button" type="button" aria-label="Choisir une autre date" data-action="menu-date#open">
                <strong>{{ date_libelle }}</strong><small>{{ date_selectionnee|date('Y') }}</small>
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"/></svg>
            </button>
            <input class="menu-date-picker__input" type="date" name="date" value="{{ date_selectionnee|date('Y-m-d') }}" min="{{ grille.dateDebut|date('Y-m-d') }}" max="{{ grille.dateFin|date('Y-m-d') }}" aria-label="Date du menu" tabindex="-1" data-menu-date-target="input" data-action="change->menu-date#navigate">
            <button class="visually-hidden" type="submit">Aller à cette date</button>
        </form>
    {% else %}<div><strong>{{ date_libelle }}</strong><small>{{ date_selectionnee|date('Y') }}</small></div>{% endif %}
    {% if jour_suivant %}<a class="group-menu-date-arrow" href="{{ path(route_date, mode_gestionnaire|default(false) ? {id: grille.id, date: jour_suivant|date('Y-m-d'), repas: repas_selectionne_id} : {date: jour_suivant|date('Y-m-d')}) }}" aria-label="Jour suivant">›</a>{% else %}<span class="group-menu-date-arrow group-menu-date-arrow--disabled" aria-hidden="true">›</span>{% endif %}
</nav>
