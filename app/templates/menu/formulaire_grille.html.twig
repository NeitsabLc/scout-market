{% extends 'base.html.twig' %}
{% set modification = grille is defined %}
{% block title %}{{ modification ? 'Modifier' : 'Ajouter' }} une grille de menus | Scout Market{% endblock %}
{% block body %}
<main class="food-form-page"><nav class="food-breadcrumb"><a href="{{ path('app_menus') }}">Grilles de menus</a><span>/</span><span>{{ modification ? 'Modifier' : 'Ajouter' }}</span></nav><header class="food-form-heading"><div><h1>{{ modification ? 'Modifier la grille' : 'Ajouter une grille de menus' }}</h1></div></header>
{% if erreurs %}<div class="distribution-errors flash" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
<form method="post"><section class="food-form-card"><h2>Informations générales</h2><input type="hidden" name="_token" value="{{ csrf_token(modification ? 'modifier_grille_menu_' ~ grille.id : 'ajouter_grille_menu') }}"><div class="group-form-field"><label for="label">Libellé de la grille</label><input id="label" name="label" maxlength="150" required autofocus value="{{ label }}" placeholder="Ex. Camp d’été"></div><div class="group-form-grid"><div class="group-form-field"><label for="date_debut">Date de début</label><input id="date_debut" name="date_debut" type="date" required value="{{ dateDebut|date('Y-m-d') }}"></div><div class="group-form-field"><label for="date_fin">Date de fin</label><input id="date_fin" name="date_fin" type="date" required value="{{ dateFin|date('Y-m-d') }}"></div></div></section><div class="food-form-actions"><a class="food-secondary" href="{{ modification ? path('app_grille_menu_modifier', {id: grille.id}) : path('app_menus') }}">Annuler</a><button class="food-primary">{{ modification ? 'Enregistrer' : 'Créer la grille' }}</button></div></form></main>
{% endblock %}
