{% if not masquer_navigation_date|default(false) %}{{ include('menu/_navigation_date.html.twig') }}{% endif %}

<div class="group-menu-meals">
    {% for repas in menus_jour %}
        {% set repas_selectionne = mode_gestionnaire|default(false) and not special|default(null) and repas.id == repas_selectionne_id %}
        <section class="group-menu-meal{{ repas_selectionne ? ' group-menu-meal--selected' : '' }}">
            <header><span class="group-menu-meal__icon" aria-hidden="true">
                {% if repas.code == 'PETIT_DEJEUNER' %}
                    <svg viewBox="0 0 24 24"><path d="M5 9h11v5a5 5 0 0 1-5 5H9a4 4 0 0 1-4-4V9Zm11 2h1.5a2.5 2.5 0 0 1 0 5H16M8 5c0 1 1 1 1 2m3-2c0 1 1 1 1 2"/></svg>
                {% elseif repas.code == 'DEJEUNER' %}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                {% elseif repas.code == 'GOUTER' %}
                    <svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-8-8 3 3 0 0 0 4 4 3 3 0 0 0 4 4Z"/><circle cx="8.5" cy="13.5" r=".7"/><circle cx="11" cy="17" r=".7"/><circle cx="7.5" cy="9" r=".7"/></svg>
                {% elseif repas.code == 'DINER' %}
                    <svg viewBox="0 0 24 24"><path d="M20 15.5A8 8 0 0 1 8.5 4 8 8 0 1 0 20 15.5Z"/></svg>
                {% else %}
                    <svg viewBox="0 0 24 24"><path d="M4 12h16M12 4v16"/></svg>
                {% endif %}
            </span><div class="group-menu-meal__title"><h2>{{ repas.libelle }}</h2>{% if mode_gestionnaire|default(false) %}<small>{{ repas.renseigne ? 'Menu renseigné' : 'À compléter' }}</small>{% endif %}</div>
            {% if mode_gestionnaire|default(false) %}<a class="group-menu-edit-link" href="{{ path('app_grille_menu_modifier', {id: grille.id, date: date_selectionnee|date('Y-m-d'), repas: repas.id}) }}#edition-menu"{{ repas_selectionne ? ' aria-current="true"' : '' }}>{{ repas_selectionne ? 'En modification' : 'Modifier' }}</a>{% endif %}</header>
            <div class="group-menu-categories">
                {% for categorie in repas.categories %}
                    <section class="group-menu-category">
                        <span class="group-menu-category__number">{{ loop.index }}</span>
                        <div><h3>{{ categorie.libelle }}</h3>
                            {% if categorie.recettes is empty and categorie.supplementaires is empty %}
                                <p class="group-menu-empty">Non renseigné</p>
                            {% else %}
                                {% for recette in categorie.recettes %}<strong class="group-menu-recipe">{{ recette }}</strong>{% endfor %}
                                {% if categorie.supplementaires is not empty %}<p class="group-menu-extras">{{ categorie.supplementaires|join(' · ') }}</p>{% endif %}
                            {% endif %}
                        </div>
                    </section>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
</div>
