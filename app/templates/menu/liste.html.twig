{% extends 'base.html.twig' %}
{% block title %}Grilles de menus | Scout Market{% endblock %}
{% block body %}
<main class="menu-grids-page entity-list-page">
    <header class="foods-heading entity-list-heading"><div><h1>Menus</h1></div><a class="food-primary food-add-button" href="{{ path('app_grille_menu_ajouter') }}" aria-label="Ajouter une grille"><span aria-hidden="true">＋</span><span class="food-add-button__label">Ajouter une grille</span></a></header>
    <section class="foods-card menu-grids-card"><div class="foods-table"><div class="foods-row foods-row--head menu-grids-row"><span>Libellé et période</span><span>Actions</span></div>
        {% if grilles is empty %}<div class="foods-empty"><strong>Aucune grille de menus</strong><span>Utilisez le bouton « Ajouter une grille » pour commencer.</span></div>
        {% else %}{% for grille in grilles %}<div class="foods-row menu-grids-row"><a class="food-name menu-grids-row__link" href="{{ path('app_grille_menu_modifier', {id: grille.id}) }}"><strong>{{ grille.label }}</strong><small>{{ grille.dateDebut|date('d/m/Y') }} — {{ grille.dateFin|date('d/m/Y') }}</small></a><span class="food-actions"><form method="post" action="{{ path('app_grille_menu_dupliquer', {id: grille.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('dupliquer_grille_menu_' ~ grille.id) }}"><button class="action-icon-button menu-grid-duplicate-button" type="submit" aria-label="Dupliquer la grille {{ grille.label }}" title="Dupliquer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><rect x="8" y="8" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-10A1.5 1.5 0 0 0 3 5.5v10A1.5 1.5 0 0 0 4.5 17H8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span class="visually-hidden">Dupliquer</span></button></form><a class="action-icon-button" href="{{ path('app_grille_menu_parametres', {id: grille.id}) }}" aria-label="Modifier le libellé et les dates de {{ grille.label }}" title="Modifier le libellé et les dates"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a></span></div>{% endfor %}{% endif %}
    </div></section>
</main>
{% endblock %}
