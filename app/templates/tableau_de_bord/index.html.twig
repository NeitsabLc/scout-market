{% extends 'base.html.twig' %}
{% macro meal_icon(code) %}<span class="home-menu-meal__icon" aria-hidden="true">{% if code == 'PETIT_DEJEUNER' %}<svg viewBox="0 0 24 24"><path d="M5 9h11v5a5 5 0 0 1-5 5H9a4 4 0 0 1-4-4V9Zm11 2h1.5a2.5 2.5 0 0 1 0 5H16M8 5c0 1 1 1 1 2m3-2c0 1 1 1 1 2"/></svg>{% elseif code == 'DEJEUNER' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>{% elseif code == 'GOUTER' %}<svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-8-8 3 3 0 0 0 4 4 3 3 0 0 0 4 4Z"/><circle cx="8.5" cy="13.5" r=".7"/><circle cx="11" cy="17" r=".7"/><circle cx="7.5" cy="9" r=".7"/></svg>{% elseif code == 'DINER' %}<svg viewBox="0 0 24 24"><path d="M20 15.5A8 8 0 0 1 8.5 4 8 8 0 1 0 20 15.5Z"/></svg>{% else %}<svg viewBox="0 0 24 24"><path d="M4 12h16M12 4v16"/></svg>{% endif %}</span>{% endmacro %}

{% block title %}Accueil — Scout Market{% endblock %}

{% block body %}
<main class="page-shell home-dashboard">
    <header class="page-heading home-dashboard__heading">
        <div><span class="eyebrow">Scout Market</span><h1>Tableau de bord</h1><p>L’intendance reste disponible toute l’année.</p></div>
        <time class="home-today" datetime="{{ aujourdhui|date('Y-m-d') }}">
            <span class="home-today__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg></span>
            <span><small>Aujourd’hui</small><strong>{{ aujourdhui|date('d/m/Y') }}</strong></span>
        </time>
    </header>

    <section class="home-kpis home-kpis--summary" aria-label="Résumé">
        <a class="home-kpi home-kpi--main" href="{{ path('app_denrees') }}"><strong>{{ nombre_denrees }}</strong><span>denrées actives</span></a>
        <a class="home-kpi" href="{{ path('app_menus') }}"><strong>{{ nombre_grilles }}</strong><span>grilles de menus</span></a>
        <a class="home-kpi" href="{{ path('app_recettes') }}"><strong>{{ nombre_recettes }}</strong><span>recettes actives</span></a>
    </section>

    <section class="home-panel" aria-labelledby="unites-presentes-title">
        <header class="home-panel__header">
            <div>
                <span class="home-panel__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="10" r="2.5"/><path d="M2 20a6 6 0 0 1 12 0M13 20a5 5 0 0 1 9 0"/></svg></span>
                <div><h2 id="unites-presentes-title">Unités présentes aujourd’hui</h2><p>Effectifs, allergènes et régimes déclarés pour le {{ aujourdhui|date('d/m/Y') }}</p></div>
            </div>
            <a href="{{ path('app_groupes') }}">Voir les unités</a>
        </header>

        <div class="home-kpis" aria-label="Effectifs présents aujourd’hui">
            <div class="home-kpi home-kpi--main"><strong>{{ resume_unites.totaux.unites }}</strong><span>unités présentes</span></div>
            <div class="home-kpi"><strong>{{ resume_unites.totaux.total }}</strong><span>personnes déclarées</span></div>
            <div class="home-kpi"><strong>{{ resume_unites.totaux.jeunes }}</strong><span>jeunes</span></div>
            <div class="home-kpi"><strong>{{ resume_unites.totaux.adultes }}</strong><span>adultes</span></div>
        </div>

        {% if resume_unites.unites is empty %}
            <p class="home-empty-copy">Aucune unité participante n’est présente aujourd’hui.</p>
        {% else %}
            <div class="home-attendance-table" role="table" aria-label="Effectifs et besoins alimentaires par unité">
                <div class="home-attendance-row home-attendance-row--head" role="row">
                    <span role="columnheader">Unité</span><span role="columnheader">Jeunes</span><span role="columnheader">Adultes</span><span role="columnheader">Total</span><span role="columnheader">Végétariens</span><span role="columnheader">Sans gluten</span><span role="columnheader">Sans lactose</span>
                </div>
                {% for ligne in resume_unites.unites %}
                    <div class="home-attendance-row" role="row" data-unit-id="{{ ligne.unite.id }}">
                        <a href="{{ path('app_groupe_modifier', {id: ligne.unite.id}) }}" role="cell">{{ ligne.unite.nom }}</a><span class="home-attendance__young" role="cell">{{ ligne.jeunes }}</span><span class="home-attendance__adults" role="cell">{{ ligne.adultes }}</span><strong class="home-attendance__total" role="cell">{{ ligne.total }}</strong><span class="home-attendance__vegetarians" role="cell">{{ ligne.vegetariens }}</span><span class="home-attendance__gluten-free" role="cell">{{ ligne.sans_gluten }}</span><span class="home-attendance__lactose-free" role="cell">{{ ligne.sans_lactose }}</span>
                    </div>
                {% endfor %}
                <div class="home-attendance-row home-attendance-row--total" role="row">
                    <strong role="cell">Total général</strong><span role="cell">{{ resume_unites.totaux.jeunes }}</span><span role="cell">{{ resume_unites.totaux.adultes }}</span><strong role="cell">{{ resume_unites.totaux.total }}</strong><span role="cell">{{ resume_unites.totaux.vegetariens }}</span><span role="cell">{{ resume_unites.totaux.sans_gluten }}</span><span role="cell">{{ resume_unites.totaux.sans_lactose }}</span>
                </div>
            </div>
        {% endif %}
    </section>

    <section class="home-panel" aria-labelledby="menus-title">
        <header class="home-panel__header"><div><h2 id="menus-title">Au menu aujourd’hui</h2><p>{{ aujourdhui|date('d/m/Y') }}</p></div><a href="{{ path('app_menus') }}">Voir les menus</a></header>
        {% if grilles_menus_du_jour is empty %}
            <p class="home-empty-copy">Aucun menu n’est renseigné pour aujourd’hui.</p>
        {% else %}
            <div class="home-menu-grids">
                {% for grille in grilles_menus_du_jour %}
                    <article class="home-menu-grid">
                        <header class="home-menu-grid__header">
                            <div class="home-menu-grid__title">
                                <span class="home-menu-grid__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
                                <div><h3>{{ grille.label }}</h3><small>{{ grille.menus|length }} repas prévu{{ grille.menus|length > 1 ? 's' : '' }} aujourd’hui</small></div>
                            </div>
                            <div class="home-menu-grid__meta"><span>{{ grille.distribution }}</span><a href="{{ path('app_grille_menu_modifier', {id: grille.id, date: aujourdhui|date('Y-m-d')}) }}">Ouvrir la grille</a></div>
                        </header>
                        <div class="home-menu-grid__meals">
                            {% for menu in grille.menus %}
                                <section class="home-menu-meal">
                                    <h4>{{ _self.meal_icon(menu.code) }}<span>{{ menu.libelle }}</span></h4>
                                    {% if menu.nom %}<strong>{{ menu.nom }}</strong>{% endif %}
                                    <p>{{ menu.elements is empty ? 'Menu non renseigné' : menu.elements|join(' · ') }}</p>
                                </section>
                            {% endfor %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}
