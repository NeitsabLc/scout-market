{% extends 'base.html.twig' %}

{% block title %}Unités participantes | Scout Market{% endblock %}

{% block body %}
<main class="groups-page stock-list-page entity-list-page" data-controller="group-dialog">
    <header class="groups-heading stock-list-heading entity-list-heading">
        <div><h1>Unités participantes</h1><p>Effectifs et besoins alimentaires permanents</p></div>
        <a class="food-primary food-add-button" href="{{ path('app_groupe_ajouter') }}" aria-label="Ajouter une unité"><span aria-hidden="true">＋</span><span class="food-add-button__label">Ajouter une unité</span></a>
    </header>

    {% for message in app.flashes('success') %}<div class="flash flash--success" role="status" data-group-dialog-target="message">{{ message }}</div>{% endfor %}

    <section class="groups-list-card object-list-card object-detail-list-card">
        <div class="object-list-summary groups-card-heading">
            <p>{{ groupes|length }} unité{{ groupes|length > 1 ? 's' : '' }} participante{{ groupes|length > 1 ? 's' : '' }}</p>
            <div class="groups-card-actions">
                <form method="get" class="inactive-groups-toggle">
                    <label><input type="checkbox" name="inactifs" value="1"{{ afficher_inactifs ? ' checked' : '' }} data-action="change->group-dialog#submitFilter"><span>Afficher les unités inactives</span></label>
                </form>
            </div>
        </div>

        {% if groupes is empty %}
            <div class="groups-empty"><strong>Aucune unité participante pour le moment</strong><span>Utilisez le bouton « Ajouter une unité » pour commencer.</span></div>
        {% else %}
            <div class="groups-list">
                {% for groupe in groupes %}
                    {% set type_court = {
                        'adulte': 'Ad',
                        'louveteaux-jeannettes': 'LJ',
                        'scouts-guides': 'SG',
                        'pionniers-caravelles': 'PC',
                        'compagnons': 'Co',
                        'farfadets': 'Fa'
                    }[groupe.type]|default(types[groupe.type]|default(groupe.type)|slice(0, 2)) %}
                    <div class="foods-swipe-row group-swipe-row"{% if groupe.actif %} data-controller="swipe-actions" data-swipe-actions-url-value="{{ path('app_groupe_modifier', {id: groupe.id}) }}"{% endif %}>
                        {% if groupe.actif %}<form class="foods-swipe-action" method="post" action="{{ path('app_groupes_supprimer', {id: groupe.id}) }}" data-swipe-actions-target="action"><input type="hidden" name="_token" value="{{ csrf_token('supprimer_groupe_' ~ groupe.id) }}"><button type="submit">Désactiver</button></form>{% endif %}
                        <article class="group-row object-detail-row{{ groupe.actif ? ' clickable-row' : ' group-row--inactive' }}"{% if groupe.actif %} role="link" tabindex="0" data-swipe-actions-target="surface" data-action="pointerdown->swipe-actions#start pointermove->swipe-actions#move pointerup->swipe-actions#end pointercancel->swipe-actions#cancel click->swipe-actions#activate keydown->swipe-actions#activate"{% endif %}>
                            <span class="group-type group-type--{{ groupe.type }}" data-short-label="{{ type_court }}">{{ types[groupe.type]|default(groupe.type|replace({'-': ' '})|title) }}</span>
                            <div class="group-row__identity">
                                <h3>{{ groupe.nom }}{% if not groupe.actif %} <span class="inactive-group-badge">Inactive</span>{% endif %}</h3>
                                <span>{{ groupe.effectifJeune + groupe.effectifAdulte }} personnes prévues</span>
                                <small>Présence du {{ groupe.dateDebutPresence|date('d/m/Y') }} au {{ groupe.dateFinPresence|date('d/m/Y') }}{% if groupe.grilleMenu %} · {{ groupe.grilleMenu.label }}{% endif %}</small>
                            </div>
                            <dl>
                                <div><dt>Jeunes</dt><dd>{{ groupe.effectifJeune }} <small>prévus</small></dd></div>
                                <div><dt>Adultes</dt><dd>{{ groupe.effectifAdulte }} <small>prévus</small></dd></div>
                            </dl>
                            {% if groupe.actif %}
                                <a class="edit-group-button" href="{{ path('app_groupe_modifier', {id: groupe.id}) }}" aria-label="Modifier l’unité {{ groupe.nom }}" title="Modifier l’unité {{ groupe.nom }}"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a>
                                <form method="post" action="{{ path('app_groupes_supprimer', {id: groupe.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('supprimer_groupe_' ~ groupe.id) }}"><button class="delete-group-button" type="submit" aria-label="Désactiver l’unité {{ groupe.nom }}" title="Désactiver l’unité {{ groupe.nom }}"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Désactiver</span></button></form>
                            {% endif %}
                        </article>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}
