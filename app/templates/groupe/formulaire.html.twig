{% extends 'base.html.twig' %}
{% block title %}{{ donnees.groupe_id ? donnees.nom : 'Ajouter une unité' }} | Scout Market{% endblock %}
{% block body %}
<main class="food-form-page"><nav class="food-breadcrumb"><a href="{{ path('app_groupes') }}">Unités participantes</a><span>/</span><span>{{ donnees.groupe_id ? 'Modifier' : 'Ajouter' }}</span></nav><header class="food-form-heading"><h1>{{ donnees.groupe_id ? donnees.nom : 'Ajouter une unité' }}</h1></header>
{% if erreurs %}<div class="flash flash--error" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_groupe') }}"><input type="hidden" name="groupe_id" value="{{ donnees.groupe_id }}">
<section class="food-form-card"><h2>Informations générales</h2><div class="group-form-grid"><div class="group-form-field"><label for="nom">Nom</label><input id="nom" name="nom" maxlength="150" required value="{{ donnees.nom }}"></div><div class="group-form-field"><label for="type">Public</label><select id="type" name="type" required>{% for code, libelle in types %}<option value="{{ code }}"{{ donnees.type == code ? ' selected' : '' }}>{{ libelle }}</option>{% endfor %}</select></div><div class="group-form-field"><label for="grille_menu">Grille de menus</label><select id="grille_menu" name="grille_menu" required><option value="">Sélectionner…</option>{% for grille in grilles_menu %}<option value="{{ grille.id }}"{{ donnees.grille_menu == grille.id ~ '' ? ' selected' : '' }}>{{ grille.label }} — {{ grille.dateDebut|date('d/m/Y') }} au {{ grille.dateFin|date('d/m/Y') }}</option>{% endfor %}</select></div></div></section>
<section class="food-form-card"><h2>Effectifs et période</h2><div class="group-form-grid"><div class="group-form-field"><label for="effectif_jeune">Jeunes</label><input id="effectif_jeune" type="number" min="0" name="effectif_jeune" required value="{{ donnees.effectif_jeune }}"></div><div class="group-form-field"><label for="effectif_adulte">Adultes</label><input id="effectif_adulte" type="number" min="0" name="effectif_adulte" required value="{{ donnees.effectif_adulte }}"></div><div class="group-form-field"><label for="date_debut_presence">Début de participation</label><input id="date_debut_presence" type="date" name="date_debut_presence" required value="{{ donnees.date_debut_presence }}"></div><div class="group-form-field"><label for="date_fin_presence">Fin de participation</label><input id="date_fin_presence" type="date" name="date_fin_presence" required value="{{ donnees.date_fin_presence }}"></div></div></section>
{% if donnees.groupe_id %}
<section class="food-form-card group-stewardship-card"><h2>Intendance</h2>
    <section class="group-meals-section"><h3>Repas de l’unité</h3><p>Ajoutez dans chaque catégorie les repas qui diffèrent du menu normal. Tous les repas non sélectionnés conserveront le menu standard.</p>
    {% if menus_configuration is empty %}<div class="foods-empty">Aucun repas daté n’est configuré pour cette grille.</div>
    {% else %}<div class="group-meal-categories">
        <section class="group-meal-category"><header><h3>Repas d’explo</h3><p>Le menu Explo sera utilisé pour les repas sélectionnés.</p></header><label>Repas concernés<select name="repas_explo[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.EXPLO ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></section>
        <section class="group-meal-category group-meal-category--picnic"><header><h3>Repas pique-nique</h3><p>Associez les repas au menu pique-nique correspondant.</p></header><div class="group-picnic-lists"><label>Pique-nique 1<select name="repas_pique_nique_1[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.PIQUE_NIQUE_1 ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label><label>Pique-nique 2<select name="repas_pique_nique_2[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.PIQUE_NIQUE_2 ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></div></section>
        <section class="group-meal-category"><header><h3>Repas non pris</h3><p>L’unité sera exclue du calcul de la commande pour ces repas.</p></header><label>Repas concernés<select name="repas_non_pris[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.NON_PRIS ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></section>
    </div>{% endif %}</section>
</section>
{% endif %}
<section class="food-form-card"><h2>Besoins alimentaires</h2><div class="group-form-grid">{% for champ, libelle in {'nombre_vegetariens':'Végétariens','nombre_sans_gluten':'Sans gluten','nombre_sans_lactose':'Sans lactose'} %}<div class="group-form-field"><label for="{{ champ }}">{{ libelle }}</label><input id="{{ champ }}" type="number" min="0" name="{{ champ }}" required value="{{ attribute(donnees, champ) }}"></div>{% endfor %}</div></section>
<div class="food-form-actions"><a class="food-secondary" href="{{ path('app_groupes') }}">Annuler</a><button class="food-primary">Enregistrer</button></div></form></main>
{% endblock %}
