# Exemple restrictif pour une installation isolée.
# Copier ce fichier dans un emplacement non suivi, adapter le sous-réseau et
# définir POSTGRES_HBA_FILE avant toute exposition réseau. Les noms de rôles
# doivent correspondre aux variables POSTGRES_*_USER du fichier .env.

local   all             all                                     scram-sha-256
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256

local   replication     all                                     scram-sha-256
host    replication     all             127.0.0.1/32            scram-sha-256
host    replication     all             ::1/128                 scram-sha-256

host    scout_market       scout_market_app          172.30.0.0/16           scram-sha-256
host    scout_market       scout_market_migrator     172.30.0.0/16           scram-sha-256
host    scout_market       scout_market_backup       172.30.0.0/16           scram-sha-256
host    scout_market       scout_market              172.30.0.0/16           scram-sha-256
host    all             scout_market_admin        172.30.0.0/16           scram-sha-256

host    all             all                     0.0.0.0/0               reject
host    all             all                     ::/0                    reject
