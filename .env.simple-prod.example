COMPOSE_PROJECT_NAME=scout-market
APP_IMAGE_TAG=v0.1.3

# Générer avec : openssl rand -hex 32
APP_SECRET=
DEFAULT_URI=https://scout-market.neitsab.net
APP_PUBLIC_URL=https://scout-market.neitsab.net
MAILER_DSN=null://null
MAILER_FROM_EMAIL=no-reply@neitsab.net
MAILER_FROM_NAME=Scout Market
MESSENGER_TRANSPORT_DSN=sync://

PHP_VERSION=8.4
PHP_IMAGE_DIGEST=sha256:9467f10bf42897dec0abb73ee20c747ebd45463ec9d6fcc4044cb83eba6dade7
NGINX_VERSION=1.29-alpine
NGINX_IMAGE_DIGEST=sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
POSTGRES_VERSION=18-alpine
POSTGRES_IMAGE_DIGEST=sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
LIQUIBASE_VERSION=5.0.3
LIQUIBASE_IMAGE_DIGEST=sha256:dfe136c26d39088d87d1bd27f833d6ac5b738a180d7c960b065c7be525725d01
AGE_PACKAGE_VERSION=1.3.1-r5

# Pour ce premier déploiement, tous les usages partagent le même rôle PostgreSQL.
# Générer un mot de passe avec « openssl rand -hex 24 » et recopier exactement la
# même valeur dans les cinq variables *_PASSWORD ci-dessous.
POSTGRES_DB=scout_market
POSTGRES_USER=scout_market
POSTGRES_PASSWORD=
POSTGRES_APP_USER=scout_market
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=scout_market
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_HEALTHCHECK_USER=scout_market
POSTGRES_HEALTHCHECK_PASSWORD=

# Le service de sauvegarde chiffrée reste désactivé dans ce déploiement simple.
POSTGRES_BACKUP_USER=scout_market
POSTGRES_BACKUP_PASSWORD=
BACKUP_AGE_RECIPIENT=

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5435
POSTGRES_HBA_FILE=./docker/postgres/pg_hba.prod.conf
CAMP_NETWORK_SUBNET=172.31.0.0/24
NGINX_BIND_ADDRESS=192.168.2.18
NGINX_HOST_PORT=8082

TRUSTED_PROXIES=192.168.2.6
TRUSTED_HOST_PATTERN=^scout-market[.]neitsab[.]net$
